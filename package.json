{
  "name": "textlint-rule-rfc2606-domains",
  "version": "0.2.1",
  "description": "textlint rule to enforce RFC 2606 reserved domains in documentation",
  "keywords": [
    "textlint",
    "textlintrule",
    "rfc2606",
    "domain",
    "example.com"
  ],
  "homepage": "https://github.com/h13/textlint-rule-rfc2606-domains",
  "repository": "h13/textlint-rule-rfc2606-domains",
  "license": "MIT",
  "author": "h13",
  "type": "module",
  "exports": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && vitest run",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepublishOnly": "pnpm run build && vitest run",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@textlint/types": "14.8.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@textlint/kernel": "14.8.4",
    "@textlint/text-to-ast": "14.8.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "4.15.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=18"
  }
}
