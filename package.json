{
  "name": "textlint-rule-rfc2606-domains",
  "version": "0.4.4",
  "description": "textlint rule to enforce RFC 2606 reserved domains in documentation",
  "keywords": [
    "textlint",
    "textlintrule",
    "rfc2606",
    "domain",
    "example.com"
  ],
  "homepage": "https://github.com/h13/textlint-rule-rfc2606-domains",
  "bugs": {
    "url": "https://github.com/h13/textlint-rule-rfc2606-domains/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h13/textlint-rule-rfc2606-domains.git"
  },
  "license": "MIT",
  "author": "h13",
  "type": "module",
  "exports": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && vitest run",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepublishOnly": "pnpm run build && vitest run",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@textlint/types": "15.5.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@textlint/kernel": "15.5.2",
    "@textlint/markdown-to-ast": "15.5.2",
    "@textlint/text-to-ast": "15.5.2",
    "@vitest/coverage-v8": "4.1.0",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.6.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vitest": "4.1.0"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
